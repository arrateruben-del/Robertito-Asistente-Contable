[Unit]
Description=Robertito - backend del bot de Telegram (@Elrobertbot)
After=network-online.target
Wants=network-online.target
# /home/ubuntu monta tarde en el arranque: no iniciar antes de que exista el proyecto.
RequiresMountsFor=/home/ubuntu

[Service]
User=ubuntu
WorkingDirectory=/home/ubuntu/Robertito-Asistente-Contable
ExecStart=/home/ubuntu/Robertito-Asistente-Contable/venv/bin/uvicorn bot.app:app --host 127.0.0.1 --port 8081
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
