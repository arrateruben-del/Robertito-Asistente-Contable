# Plantilla de variables de entorno para Robertito (copiar a .env y completar).
# NO incluir valores reales en este archivo. El .env real está en .gitignore.

# Token del bot de Telegram (@Elrobertbot). NO commitear.
BOT_TOKEN=

# URL pública del webhook (apunta a este backend, HTTPS).
WEBHOOK_URL=https://robertito-bot-ruben.abacusai.cloud/webhook/<secret_path>

# URL pública de la Mini App hosteada por nosotros (HTTPS, requerido por Telegram).
WEBAPP_URL=https://robertito-bot-ruben.abacusai.cloud/app

# Ruta secreta del endpoint del webhook (último segmento de la URL del webhook).
WEBHOOK_SECRET_PATH=

# Secret token que Telegram envía en el header X-Telegram-Bot-Api-Secret-Token.
WEBHOOK_SECRET_TOKEN=

# Allowlist opcional de chat IDs habilitados (separados por coma). Vacío = todos.
ALLOWED_CHAT_IDS=

# Puerto interno del proceso del bot (proxiado por nginx).
PORT=8081

# CUIT del agente de retención (estudio) para la cabecera del archivo SICORE.
CUIT_AGENTE_RETENCION=
